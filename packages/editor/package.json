{
    "name": "windcraft-editor",
    "version": "0.1.0",
    "description": "Windcraft's visual HTML + Tailwind editor. Mount it in a page and give it a host that loads and saves designs. Includes @windcraft/core.",
    "keywords": [
        "tailwind",
        "tailwindcss",
        "visual-editor",
        "design-tool",
        "html",
        "wysiwyg",
        "windcraft"
    ],
    "type": "module",
    "license": "MIT",
    "author": "Swapnil Jadhav",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Tolaj/windcraft.git",
        "directory": "packages/editor"
    },
    "homepage": "https://github.com/Tolaj/windcraft#readme",
    "bugs": {
        "url": "https://github.com/Tolaj/windcraft/issues"
    },
    "main": "index.js",
    "exports": {
        ".": "./index.js",
        "./*": "./*"
    },
    "files": [
        "index.js",
        "embed.js",
        "embed.html",
        "embed-frame.js",
        "template.js",
        "styles.css",
        "design",
        "playground",
        "vendor",
        "core",
        "README.md"
    ],
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "prepack": "node scripts/bundle-core.mjs",
        "postpack": "node scripts/bundle-core.mjs clean"
    }
}
