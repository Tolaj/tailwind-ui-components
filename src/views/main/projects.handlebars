<main class="min-w-0 flex-1 p-6">
    <div class="flex flex-wrap items-end justify-between gap-4 mb-6">
        <div>
            <h1 class="text-4xl font-bold text-gray-900 mb-2">Projects</h1>
            <p class="text-gray-600">Group the pages and sections of a website or app, like a Figma file. Claude can file designs straight into a project.</p>
        </div>
        <div class="flex items-center gap-2">
        <a href="/projects/design-guide.md?download=1" class="inline-flex h-9 items-center rounded-md border border-gray-300 bg-white px-4 text-sm font-medium text-gray-800 hover:bg-gray-50" title="A markdown guide generated from your designs, for a CLAUDE.md or an agent">Design guide</a>
        </div>
    </div>

    {{#if projects.length}}
    {{!-- Search and the category filter are in the top bar; the tags of the designs are chips here --}}
    <div class="mb-6">
        {{#if tagChips.length}}
        <div id="tagBar" class="flex flex-wrap items-center gap-1.5">
            {{#each tagChips}}
            <button type="button" data-tag="{{this.name}}" aria-pressed="false" class="tag-chip rounded-full border border-gray-300 bg-white px-3 py-1 text-xs font-medium text-gray-700 hover:bg-gray-50">{{this.name}} <span class="text-gray-400">{{this.count}}</span></button>
            {{/each}}
        </div>
        {{/if}}
    </div>
    <p id="projNone" class="hidden rounded-xl border border-dashed border-gray-300 bg-white p-10 text-center text-sm text-gray-500">No project matches.</p>
    <div id="projGrid" class="grid grid-cols-1 gap-5 sm:grid-cols-2 xl:grid-cols-3">
        {{#each projects}}
        <a href="/projects/{{this.id}}" data-card data-name="{{this.name}} {{this.description}}" data-cats="{{this.catSlugs}}" data-tags="{{this.tagList}}" class="group rounded-xl border border-gray-200 bg-white p-5 transition-colors hover:border-gray-400">
            <div class="flex items-start justify-between gap-2">
                <h2 class="truncate text-base font-semibold text-gray-900">{{this.name}}{{#if this.active}} <span class="ml-1 rounded-full bg-blue-50 px-2 py-0.5 align-middle text-[10px] font-medium text-blue-700">Active</span>{{/if}}</h2>
                <span class="shrink-0 text-xs text-gray-400">{{formatDate this.updatedAt}}</span>
            </div>
            <p class="mt-1 line-clamp-2 min-h-[2.5rem] text-sm text-gray-500">{{#if this.description}}{{this.description}}{{else}}No description{{/if}}</p>
            <div class="mt-3 flex min-h-[1.5rem] flex-wrap items-center gap-1.5">
                {{#each this.catNames}}{{#if (lt @index 5)}}<span class="inline-flex items-center gap-1 whitespace-nowrap rounded-full bg-gray-100 px-2 py-0.5 text-[11px] font-medium leading-4 text-gray-700">{{this.name}}{{#if (gt this.count 1)}}<span class="text-gray-400">{{this.count}}</span>{{/if}}</span>{{/if}}{{/each}}
                {{#if (gt this.catNames.length 5)}}<span class="inline-flex items-center rounded-full bg-gray-100 px-2 py-0.5 text-[11px] leading-4 text-gray-500">+{{minus this.catNames.length 5}}</span>{{/if}}
            </div>
            <div class="mt-3 flex gap-4 text-sm text-gray-700">
                <span><strong class="text-gray-900">{{this.pages}}</strong> page{{#unless (eq this.pages 1)}}s{{/unless}}</span>
                <span><strong class="text-gray-900">{{this.components}}</strong> component{{#unless (eq this.components 1)}}s{{/unless}}</span>
            </div>
        </a>
        {{/each}}
    </div>
    {{else}}
    <div class="rounded-xl border border-dashed border-gray-300 bg-white p-12 text-center">
        <h3 class="text-base font-semibold text-gray-900">No projects yet</h3>
        <p class="mx-auto mt-1 max-w-md text-sm text-gray-500">Create one, then ask Claude: <em>"Design a landing page and a pricing page for Acme and save them in a project called Acme website."</em></p>
    </div>
    {{/if}}
</main>
<script>
    (function () {
        var cards = [].slice.call(document.querySelectorAll("[data-card]")), q = "", cats = [], tags = [];
        function apply() {
            var shown = 0;
            cards.forEach(function (c) {
                var mine = " " + c.dataset.cats + " ", theirs = (c.dataset.tags || "").split("\u0001");
                var ok = (!cats.length || cats.some(function (x) { return mine.indexOf(" " + x + " ") >= 0; }))
                    && (!tags.length || tags.some(function (t) { return theirs.indexOf(t) >= 0; }))
                    && q.split(/\s+/).every(function (w) { return !w || (c.dataset.name + " " + c.dataset.cats + " " + theirs.join(" ")).toLowerCase().indexOf(w) >= 0; });
                c.classList.toggle("hidden", !ok);
                if (ok) shown++;
            });
            var none = document.getElementById("projNone");
            if (none) none.classList.toggle("hidden", shown > 0);
        }
        var s = document.getElementById("projSearch");
        if (s) s.addEventListener("input", function (e) { q = e.target.value.trim().toLowerCase(); apply(); });

        var btn = document.getElementById("catBtn"), panel = document.getElementById("catPanel");
        if (btn) {
            var boxes = [].slice.call(panel.querySelectorAll(".cat-box"));
            var label = function () {
                var names = boxes.filter(function (b) { return b.checked; }).map(function (b) { return b.parentNode.querySelector("span").textContent; });
                document.getElementById("catLabel").textContent = !names.length ? "All Categories" : names.length === 1 ? names[0] : names.length + " categories";
            };
            var toggle = function (open) { panel.classList.toggle("hidden", !open); btn.setAttribute("aria-expanded", open); };
            btn.addEventListener("click", function () { toggle(panel.classList.contains("hidden")); });
            document.addEventListener("click", function (e) { if (!e.target.closest("#catMenu")) toggle(false); });
            document.addEventListener("keydown", function (e) { if (e.key === "Escape") toggle(false); });
            panel.addEventListener("change", function () { cats = boxes.filter(function (b) { return b.checked; }).map(function (b) { return b.value; }); label(); apply(); });
            document.getElementById("catClear").addEventListener("click", function () { boxes.forEach(function (b) { b.checked = false; }); cats = []; label(); apply(); });
        }

        var bar = document.getElementById("tagBar");
        if (bar) bar.addEventListener("click", function (e) {
            var b = e.target.closest(".tag-chip");
            if (!b) return;
            var on = b.getAttribute("aria-pressed") !== "true";
            b.setAttribute("aria-pressed", on);
            ["bg-black", "text-white", "border-gray-900"].forEach(function (k) { b.classList.toggle(k, on); });
            ["bg-white", "text-gray-700", "border-gray-300"].forEach(function (k) { b.classList.toggle(k, !on); });
            tags = [].slice.call(bar.querySelectorAll('[aria-pressed="true"]')).map(function (x) { return x.dataset.tag; });
            apply();
        });
    })();
</script>
