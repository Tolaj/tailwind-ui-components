<main class="flex-1 min-w-0 p-6">
    <div class="flex flex-wrap items-end justify-between gap-4 mb-6">
        <div>
            <h1 class="text-3xl font-semibold tracking-[-0.035em] text-gray-900">Library</h1>
            <p class="mt-1 text-sm text-gray-500">Your components. Reused by AI generation, exportable to any framework, and readable by your coding agents.</p>
        </div>
        <div class="flex items-center gap-2">
                <button type="button" id="importBtn" class="h-9 rounded-md border border-gray-300 bg-white px-4 text-sm font-medium text-gray-800 hover:bg-gray-50" title="Import HTML files, for example designs from Claude Design">Import HTML</button>
        </div>
    </div>

    {{!-- Connect --}}
    <section class="mb-8 rounded-xl border border-gray-200 bg-white p-5">
        <div class="flex flex-wrap items-start justify-between gap-4">
            <div class="max-w-xl">
                <h2 class="text-sm font-semibold text-gray-900">Connect your coding agent</h2>
                <p class="mt-1 text-sm text-gray-500">Claude Code, Cursor and any MCP client can search and fetch these components, and save new ones back. Your library becomes the source of truth instead of pasted snippets.</p>
            </div>
            <div class="flex items-center gap-2">
                {{#if tokenPrefix}}<span class="text-xs text-gray-500">Token <code class="font-mono">{{tokenPrefix}}…</code> active</span>{{/if}}
                <button type="button" id="genTokenBtn" class="h-8 rounded-md border border-gray-300 px-3 text-[13px] font-medium text-gray-800 hover:bg-gray-50">
                    {{#if tokenPrefix}}Regenerate token{{else}}Generate token{{/if}}
                </button>
            </div>
        </div>
        <div id="connectBox" class="hidden mt-4">
            <p class="mb-1.5 text-xs text-gray-500">Run this once. The token is shown only now, copy it somewhere safe.</p>
            <div class="flex items-stretch gap-2">
                <pre id="connectCmd" class="flex-1 overflow-x-auto rounded-md border border-gray-200 bg-gray-50 p-3 font-mono text-[12px] leading-5 text-gray-900"></pre>
                <button type="button" id="copyCmdBtn" class="h-auto rounded-md border border-gray-300 px-3 text-[13px] font-medium hover:bg-gray-50">Copy</button>
            </div>
            <p class="mt-2 text-xs text-gray-500"><a href="/connect" class="font-medium underline">More ways to connect</a> (project config, skill, Claude Design pack).</p>
            <p class="mt-2 text-xs text-gray-500">Tools: <code class="font-mono">get_design_guide</code>, <code class="font-mono">search_components</code>, <code class="font-mono">get_component</code>, <code class="font-mono">save_component</code>, <code class="font-mono">list_tags</code></p>
        </div>
    </section>

    {{!-- Toolbar --}}
    <div class="mb-4 flex flex-wrap items-center gap-3">
        <input id="libSearch" type="search" placeholder="Search {{count}} components"
            class="h-9 w-72 rounded-md border border-gray-300 bg-white px-3 text-sm placeholder-gray-400 focus:border-gray-900 focus:outline-none focus:ring-1 focus:ring-gray-900" />
        <select id="projectFilter" class="h-9 rounded-md border border-gray-300 bg-white px-2 text-sm text-gray-800"><option value="">All projects</option></select>
        <button type="button" id="guideBtn" class="h-9 rounded-md border border-gray-300 bg-white px-3 text-[13px] font-medium text-gray-800 hover:bg-gray-50" title="A markdown summary of your design system, generated from your components">Design guide</button>
        <div id="tagBar" class="flex flex-wrap items-center gap-1.5">
            <button type="button" data-tag="" class="tag-chip rounded-full border border-gray-900 bg-black px-3 py-1 text-xs font-medium text-white">All</button>
            {{#each tags}}
            <button type="button" data-tag="{{this.name}}" class="tag-chip rounded-full border border-gray-300 bg-white px-3 py-1 text-xs font-medium text-gray-700 hover:border-gray-500">{{this.name}} <span class="text-gray-400">{{this.count}}</span></button>
            {{/each}}
        </div>
    </div>

    <div id="libGrid" class="grid grid-cols-1 gap-5 md:grid-cols-2 xl:grid-cols-3"></div>

    <div id="libEmpty" class="hidden rounded-xl border border-dashed border-gray-300 bg-white p-12 text-center">
        <h3 class="text-base font-semibold text-gray-900">{{#if count}}No matches{{else}}Your library is empty{{/if}}</h3>
        <p class="mt-1 text-sm text-gray-500">{{#if count}}Try a different search or tag.{{else}}Create your first component, or have your coding agent save one with <code class="font-mono">save_component</code>.{{/if}}</p>
    </div>
</main>

{{!-- Export / history modal --}}
<dialog id="libModal" class="m-auto w-[min(860px,92vw)] rounded-xl border border-gray-200 p-0 shadow-[0_16px_48px_rgba(0,0,0,0.2)] backdrop:bg-black/40">
    <div class="flex items-center justify-between border-b border-gray-200 px-5 py-3">
        <h3 id="libModalTitle" class="text-sm font-semibold text-gray-900"></h3>
        <button type="button" id="libModalClose" class="h-7 w-7 rounded text-gray-500 hover:bg-gray-100" aria-label="Close">✕</button>
    </div>
    <div class="flex items-center gap-1 border-b border-gray-200 px-4 py-2" id="libTabs"></div>
    <div class="relative">
        <a id="libDownload" href="/library/design-guide.md?download=1" class="absolute right-16 top-3 hidden h-7 items-center rounded-md border border-gray-300 bg-white px-2.5 text-xs font-medium hover:bg-gray-50">Download .md</a>
        <button type="button" id="libCopy" class="absolute right-3 top-3 hidden h-7 rounded-md border border-gray-300 bg-white px-2.5 text-xs font-medium hover:bg-gray-50">Copy</button>
        <pre id="libCode" class="max-h-[60vh] overflow-auto whitespace-pre-wrap break-words bg-gray-50 p-5 font-mono text-[12px] leading-5 text-gray-900"></pre>
        <div id="libHistory" class="hidden max-h-[60vh] overflow-auto divide-y divide-gray-100"></div>
    </div>
</dialog>

{{!-- Import modal --}}
<dialog id="importModal" class="m-auto w-[min(640px,92vw)] rounded-xl border border-gray-200 p-0 shadow-[0_16px_48px_rgba(0,0,0,0.2)] backdrop:bg-black/40">
    <div class="flex items-center justify-between border-b border-gray-200 px-5 py-3">
        <h3 class="text-sm font-semibold text-gray-900">Import designs</h3>
        <button type="button" id="importClose" class="h-7 w-7 rounded text-gray-500 hover:bg-gray-100" aria-label="Close">✕</button>
    </div>
    <div class="space-y-4 p-5">
        <label id="dropZone" class="block cursor-pointer rounded-lg border-2 border-dashed border-gray-300 p-8 text-center transition-colors hover:border-gray-500">
            <span class="block text-sm font-medium text-gray-900">Drop HTML or .zip files here</span>
            <span class="mt-1 block text-xs text-gray-500">or click to choose. A zip can hold many pages.</span>
            <input type="file" id="importInput" accept=".html,.htm,.zip,text/html,application/zip" multiple class="hidden">
        </label>
        <ul id="importFiles" class="hidden max-h-28 divide-y divide-gray-100 overflow-auto rounded-lg border border-gray-200 text-sm"></ul>

        <div>
            <p class="mb-1.5 text-xs font-medium text-gray-600">Or paste HTML</p>
            <input id="pasteTitle" type="text" placeholder="Name (optional)" class="mb-2 h-9 w-full rounded-md border border-gray-300 px-3 text-sm placeholder-gray-400 focus:border-gray-900 focus:outline-none focus:ring-1 focus:ring-gray-900">
            <textarea id="pasteHtml" rows="5" spellcheck="false" placeholder="<!doctype html> ..." class="w-full rounded-md border border-gray-300 p-3 font-mono text-[12px] leading-5 placeholder-gray-400 focus:border-gray-900 focus:outline-none focus:ring-1 focus:ring-gray-900"></textarea>
        </div>

        <label class="flex cursor-pointer items-start gap-2 text-sm text-gray-700">
            <input id="splitToggle" type="checkbox" checked class="mt-1 h-4 w-4 rounded border-gray-300 accent-black">
            <span><strong class="text-gray-900">Split pages into sections.</strong> Each page is saved whole, and its header, hero, pricing, footer and so on are saved as separate components you can reuse.</span>
        </label>
        <p id="importStatus" class="hidden text-sm"></p>
    </div>
    <div class="flex justify-end gap-2 border-t border-gray-200 px-5 py-3">
        <button type="button" id="importCancel" class="h-9 rounded-md border border-gray-300 px-4 text-sm font-medium text-gray-800 hover:bg-gray-50">Cancel</button>
        <button type="button" id="importGo" class="h-9 rounded-md bg-black px-4 text-sm font-medium text-white hover:bg-neutral-800 disabled:opacity-50">Import</button>
    </div>
</dialog>


<script id="projectsData" type="application/json">{{{projectsJson}}}</script>
<script id="libraryData" type="application/json">{{{libraryJson}}}</script>
<script>window.__LIB = { mcpUrl: "{{mcpUrl}}" };</script>


<script type="module" src="/public/js/library.js"></script>
