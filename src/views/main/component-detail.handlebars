<div class="max-w-7xl flex-1 mx-auto p-6">
    <div class="mb-6">
        <a href="javascript:history.back()" class="text-sm text-gray-500 hover:text-gray-700 flex items-center gap-1">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
            </svg>
            Back
        </a>
    </div>

    <div class="mb-8">
        <h1 class="text-4xl font-bold text-gray-900 mb-2">{{component.title}}</h1>
        <p class="text-gray-600">{{component.description}}</p>
        <div class="flex items-center gap-4 mt-3 text-sm text-gray-500">
            <span>{{component.views}} views</span>
            <span>{{component.likes}} likes</span>
            {{#if component.isNew}}
            <span class="bg-green-100 text-green-700 px-2 py-0.5 rounded-full text-xs font-medium">New</span>
            {{/if}}
        </div>
    </div>

    <div class="space-y-20">
        {{> component-preview component}}
    </div>
</div>

{{> component-playground/index}}

<script type="module" src="/public/js/category.js"></script>
