<div class="max-w-7xl flex-1 mx-auto p-6">
    <div class="mb-8">
        <h1 class="text-4xl font-bold text-gray-900 mb-2">Catalog</h1>
        <p class="text-gray-600 max-w-2xl">Finished parts, each with every style, size and state. They use your project's theme, work in light and dark, and come as HTML, React, Vue and Svelte.</p>
    </div>
    <div id="catalogGrid" class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {{#each families}}
        <a href="/catalog/{{slug}}" class="group block rounded-xl border border-gray-200 bg-white transition-shadow hover:shadow-md">
            <div class="h-40 overflow-hidden rounded-t-xl border-b border-gray-100 bg-gray-50">
                <iframe data-sample="{{slug}}" title="{{name}}" class="pointer-events-none h-full w-full border-0" tabindex="-1" loading="lazy"></iframe>
            </div>
            <div class="p-4">
                <div class="flex items-center justify-between"><h2 class="text-base font-semibold text-gray-900">{{name}}</h2><span class="text-xs text-gray-500">{{styles}} styles</span></div>
                <p class="mt-1 text-sm text-gray-500">{{description}}</p>
            </div>
        </a>
        {{/each}}
    </div>
    {{#unless families.length}}<p class="text-gray-500">The catalog is being built.</p>{{/unless}}
</div>
<script id="catalogData" type="application/json">{{{json families}}}</script>
<script type="module" src="/public/js/catalog.js"></script>
