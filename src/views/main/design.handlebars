<div class="flex h-screen flex-col">
    <header class="flex h-12 shrink-0 items-center gap-3 border-b border-neutral-200 bg-white px-3 text-[13px]">
        <a href="/library" class="flex items-center gap-1 rounded-md px-2 py-1 text-neutral-600 hover:bg-neutral-100" title="Back to library">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5"/></svg>Library</a>
        <div class="h-5 w-px bg-neutral-200"></div>
        <div class="min-w-0"><span class="truncate font-semibold text-neutral-900">{{componentTitle}}</span> <span id="versionBadge" class="ml-1 rounded bg-neutral-100 px-1.5 py-0.5 font-mono text-[11px] text-neutral-600"></span></div>

        <div class="ml-auto flex items-center gap-2">
            <div class="flex items-center gap-0.5">
                <button id="undoBtn" type="button" title="Undo (Ctrl/Cmd+Z)" class="h-8 w-8 rounded-md text-neutral-600 hover:bg-neutral-100 disabled:opacity-30"><svg class="mx-auto h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 15 3 9m0 0 6-6M3 9h12a6 6 0 0 1 0 12h-3"/></svg></button>
                <button id="redoBtn" type="button" title="Redo (Ctrl/Cmd+Shift+Z)" class="h-8 w-8 rounded-md text-neutral-600 hover:bg-neutral-100 disabled:opacity-30"><svg class="mx-auto h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="m15 15 6-6m0 0-6-6m6 6H9a6 6 0 0 0 0 12h3"/></svg></button>
            </div>
            <div class="h-5 w-px bg-neutral-200"></div>
            <div id="deviceSeg" class="seg flex overflow-hidden rounded-md border border-neutral-300">
                <button type="button" data-device="1280" class="is-on px-2.5 py-1 text-xs font-medium">Desktop</button>
                <button type="button" data-device="768" class="border-l border-neutral-300 px-2.5 py-1 text-xs font-medium">Tablet</button>
                <button type="button" data-device="390" class="border-l border-neutral-300 px-2.5 py-1 text-xs font-medium">Mobile</button>
            </div>
            <select id="zoomSel" class="h-8 rounded-md border border-neutral-300 bg-white px-2 text-xs"><option value="fit">Fit</option><option value="1">100%</option><option value="0.75">75%</option><option value="0.5">50%</option></select>
            <div id="modeSeg" class="seg flex overflow-hidden rounded-md border border-neutral-300">
                <button type="button" data-mode="edit" class="is-on px-2.5 py-1 text-xs font-medium">Edit</button>
                <button type="button" data-mode="preview" class="border-l border-neutral-300 px-2.5 py-1 text-xs font-medium" title="Run it with its JavaScript">Preview</button>
            </div>
            <span id="saveState" class="min-w-[70px] text-right text-xs text-neutral-500"></span>
            <button id="saveBtn" type="button" class="h-8 rounded-md bg-black px-4 text-xs font-medium text-white hover:bg-neutral-800 disabled:opacity-40">Save</button>
        </div>
    </header>

    <div class="flex min-h-0 flex-1">
        <aside class="flex w-64 shrink-0 flex-col border-r border-neutral-200 bg-white">
            <div class="border-b border-neutral-200 px-3 py-2 text-[11px] font-semibold uppercase tracking-wide text-neutral-500">Layers</div>
            <div id="layers" class="min-h-0 flex-1 overflow-auto p-1 text-[12px]"></div>
        </aside>

        <main id="canvas" class="relative min-w-0 flex-1 overflow-auto bg-neutral-100 p-6">
            <div id="frameWrap" class="mx-auto">
                <iframe id="frame" title="Design canvas" sandbox="allow-scripts" class="block origin-top-left bg-white shadow-[0_1px_3px_rgba(0,0,0,.15)]" style="border:0;transform-origin:0 0"></iframe>
            </div>
            <p id="canvasHint" class="mt-3 text-center text-xs text-neutral-500">Click to select. Double-click text to edit it. Drag layers to reorder.</p>
        </main>

        <aside class="flex w-72 shrink-0 flex-col border-l border-neutral-200 bg-white">
            <div class="border-b border-neutral-200 px-3 py-2 text-[11px] font-semibold uppercase tracking-wide text-neutral-500">Inspector</div>
            <div id="inspector" class="min-h-0 flex-1 overflow-auto text-[12px]"></div>
        </aside>
    </div>
</div>

<script id="designData" type="application/json">{{{dataJson}}}</script>
<script type="module" src="/public/js/design/editor.js"></script>
