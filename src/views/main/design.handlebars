<div class="flex h-screen flex-col">
    <header class="flex h-10 shrink-0 items-center gap-2 border-b border-neutral-200 bg-white px-2 text-[12px]">
        <a href="/library" id="backLink" class="flex items-center gap-1 rounded-md px-2 py-1 text-neutral-600 hover:bg-neutral-100" title="Back to library">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5"/></svg><span id="backLabel">Library</span></a>
        <div class="h-5 w-px bg-neutral-200"></div>
        <a id="projLink" href="#" class="hidden max-w-[140px] items-center truncate rounded-md px-1.5 py-1 text-neutral-500 hover:bg-neutral-100" title="Open the project"></a>
        <span id="projSep" class="hidden text-neutral-300">/</span>
        <button id="detailsBtn" type="button" class="flex min-w-0 items-center gap-1.5 rounded-md px-2 py-1 hover:bg-neutral-100" title="Name, category, tags and visibility">
            <span id="titleText" class="truncate font-semibold text-neutral-900"></span>
            <span id="versionBadge" class="rounded bg-neutral-100 px-1.5 py-0.5 font-mono text-[11px] text-neutral-600"></span>
            <svg class="h-3.5 w-3.5 shrink-0 text-neutral-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Z"/></svg>
        </button>
        <div class="ml-auto flex items-center gap-2">
            <span id="saveState" class="min-w-[70px] text-right text-xs text-neutral-500"></span>
            <button id="saveBtn" type="button" class="h-7 rounded-md bg-[#0d99ff] px-4 text-xs font-semibold text-white hover:bg-[#0a84e0] disabled:opacity-40">Save</button>
        </div>
    </header>

    <div class="flex min-h-0 flex-1">
        <section class="relative flex min-w-0 flex-1 flex-col">
            {{!-- Floating controls: designs and tools on the left, view controls on the right --}}
            <div class="pill absolute left-3 top-3 z-30 flex items-center gap-0.5 p-1">
                <div class="relative">
                    <button id="designsBtn" type="button" class="flex h-8 max-w-[220px] items-center gap-1.5 rounded-lg px-2 text-[13px] font-medium text-neutral-800 hover:bg-neutral-100" title="Designs on this canvas">
                        <span id="designsCount" class="rounded-full bg-neutral-100 px-1.5 text-[11px] text-neutral-600">1</span>
                        <span id="designsName" class="truncate">Design</span>
                        <svg class="h-3.5 w-3.5 shrink-0 text-neutral-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m6 9 6 6 6-6"/></svg>
                    </button>
                    <div id="designsMenu" class="pop absolute left-0 top-10 z-40 hidden w-64 p-1">
                        <div id="designs" class="max-h-72 overflow-auto text-[12px]"></div>
                        <button id="newDesignBtn" type="button" class="mt-1 flex h-8 w-full items-center gap-2 rounded-lg border-t border-neutral-100 px-2 text-left text-[12px] font-medium text-neutral-700 hover:bg-neutral-100">+ New design on this canvas</button>
                    </div>
                </div>
                <span class="mx-0.5 h-5 w-px bg-neutral-200"></span>
                <div id="toolbar" class="flex items-center gap-0.5"></div>
                <span class="mx-0.5 h-5 w-px bg-neutral-200"></span>
                <div class="relative">
                    <button id="addBtn" type="button" title="Insert a block" class="tbtn"><svg class="mx-auto h-[18px] w-[18px]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" ><path d="M12 5v14M5 12h14"/></svg></button>
                    <div id="addMenu" class="pop absolute left-0 top-10 z-40 hidden w-48 p-1"></div>
                </div>
            </div>
            <div id="pillR" class="pill absolute right-3 top-3 z-30 flex items-center gap-0.5 p-1">
                <button id="undoBtn" type="button" title="Undo (Ctrl/Cmd+Z)" class="tbtn disabled:opacity-30"><svg class="mx-auto h-[18px] w-[18px]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" ><path d="M9 15 3 9m0 0 6-6M3 9h12a6 6 0 0 1 0 12h-3"/></svg></button>
                <button id="redoBtn" type="button" title="Redo (Ctrl/Cmd+Shift+Z)" class="tbtn disabled:opacity-30"><svg class="mx-auto h-[18px] w-[18px]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" ><path d="m15 15 6-6m0 0-6-6m6 6H9a6 6 0 0 0 0 12h3"/></svg></button>
                <span class="mx-0.5 h-5 w-px bg-neutral-200"></span>
                <button id="codeBtn" type="button" title="View and edit the HTML" class="tbtn"><svg class="mx-auto h-[18px] w-[18px]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" ><path d="m8 8-4 4 4 4M16 8l4 4-4 4M14 5l-4 14"/></svg></button>
                <button id="playBtn" type="button" title="Preview: run it with its JavaScript" class="tbtn"><svg class="mx-auto h-[18px] w-[18px]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" ><path d="M7 5v14l12-7z"/></svg></button>
                <button id="panelBtn" type="button" title="Properties and layers" class="tbtn"><svg class="mx-auto h-[18px] w-[18px]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" ><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M14 4v16"/></svg></button>
                <select id="zoomSel" class="h-8 rounded-lg border-0 bg-transparent pl-1 pr-0 text-[13px] font-medium text-neutral-800 hover:bg-neutral-100 focus:outline-none" title="Zoom (Shift+1 fit all, Shift+2 fit this design)"><option value="fit">Fit all</option><option value="frame">Fit this design</option><option value="2">200%</option><option value="1">100%</option><option value="0.75">75%</option><option value="0.5">50%</option><option value="0.25">25%</option></select>
            </div>

            <main id="canvas" class="relative min-h-0 flex-1 overflow-hidden" style="touch-action:none">
                <div id="plane" class="absolute left-0 top-0" style="transform-origin:0 0">
                    <div id="frames"></div>
                    <iframe id="frame" title="Design canvas" sandbox="allow-scripts" class="block bg-white" style="border:0;position:absolute;left:0;top:0"></iframe>
                    <div id="fsel" class="pointer-events-none absolute hidden"></div>
                </div>
                <div id="panShield" class="absolute inset-0 z-20 hidden" style="cursor:grab"></div>
                <div id="ftb" class="pill absolute z-30 hidden items-center gap-0.5 p-1"></div>
                <p id="canvasHint" class="pointer-events-none absolute bottom-3 left-1/2 z-10 -translate-x-1/2 whitespace-nowrap rounded-full bg-white/90 px-3 py-1 text-[11px] text-neutral-500 shadow-[0_1px_4px_rgba(0,0,0,.12)]">Click to select. Double-click text to edit it. Scroll to pan, Ctrl/Cmd + scroll to zoom.</p>

                {{!-- Start screen for an empty design --}}
                <div id="startCard" class="pointer-events-none absolute inset-0 z-20 hidden items-center justify-center p-6">
                    <div class="pointer-events-auto w-full max-w-lg rounded-xl border border-neutral-200 bg-white p-6 shadow-[0_6px_20px_rgba(0,0,0,.08)]">
                        <h2 class="text-lg font-semibold tracking-tight text-neutral-900">Start a new design</h2>
                        <p class="mt-1 text-sm text-neutral-500">Describe it and let AI draft it, paste code you already have, or build it from blocks.</p>
                        <textarea id="startPrompt" rows="3" class="field mt-4" placeholder="e.g. a pricing section with three tiers and a highlighted middle plan"></textarea>
                        <button id="startGo" type="button" class="mt-2 h-9 w-full rounded-md bg-black text-sm font-medium text-white hover:bg-neutral-800 disabled:opacity-50">Generate with AI</button>
                        <p id="startNote" class="mt-2 hidden text-xs"></p>
                        <div class="my-4 flex items-center gap-3 text-xs text-neutral-400"><span class="h-px flex-1 bg-neutral-200"></span>or<span class="h-px flex-1 bg-neutral-200"></span></div>
                        <div class="grid grid-cols-2 gap-2">
                            <button id="startPaste" type="button" class="h-9 rounded-md border border-neutral-300 text-sm font-medium hover:bg-neutral-50">Paste HTML or code</button>
                            <button id="startBlank" type="button" class="h-9 rounded-md border border-neutral-300 text-sm font-medium hover:bg-neutral-50">Start with a section</button>
                        </div>
                    </div>
                </div>
            </main>

            {{!-- Code panel --}}
            <div id="codePanel" class="hidden h-64 shrink-0 flex-col border-t border-neutral-200 bg-white">
                <div class="flex h-8 shrink-0 items-center justify-between border-b border-neutral-200 bg-neutral-50 px-3 text-[11px]">
                    <span class="font-semibold uppercase tracking-wide text-neutral-500">Code <span class="ml-1 font-normal normal-case text-neutral-400">HTML, Tailwind, CSS and JS. Changes apply as you type.</span></span>
                    <button id="codeClose" type="button" class="rounded px-2 py-0.5 text-neutral-500 hover:bg-neutral-200">Hide</button>
                </div>
                <textarea id="codeText" spellcheck="false" class="min-h-0 w-full flex-1 resize-none border-0 bg-neutral-50 p-3 font-mono text-[12px] leading-5 text-neutral-900 focus:bg-white focus:outline-none"></textarea>
            </div>
        </section>

        {{!-- Closed until you ask for it; the floating toolbar covers everyday edits --}}
        <aside id="panel" class="hidden w-[288px] shrink-0 flex-col border-l border-neutral-200 bg-white">
            <div class="flex items-center gap-1 border-b border-neutral-200 px-2 py-1.5">
                <div id="panelTabs" class="flex gap-0.5">
                    <button type="button" data-ptab="props" class="ptab is-on">Properties</button>
                    <button type="button" data-ptab="layers" class="ptab">Layers</button>
                </div>
                <button id="panelClose" type="button" title="Close" class="ml-auto flex h-6 w-6 items-center justify-center rounded text-neutral-500 hover:bg-neutral-100">
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"/></svg>
                </button>
            </div>
            <div id="inspector" class="min-h-0 flex-1 overflow-auto"></div>
            <div id="layersPane" class="hidden min-h-0 flex-1 overflow-auto p-1"><div id="layers" class="text-[12px]"></div></div>
        </aside>
    </div>
</div>

{{!-- Details dialog --}}
<dialog id="detailsDlg" class="m-auto w-[min(520px,92vw)] rounded-xl border border-neutral-200 p-0 shadow-[0_16px_48px_rgba(0,0,0,.2)] backdrop:bg-black/40">
    <form id="detailsForm" method="dialog">
        <div class="border-b border-neutral-200 px-5 py-3"><h3 id="detailsTitle" class="text-sm font-semibold text-neutral-900">Component details</h3></div>
        <div class="space-y-4 p-5">
            <div><label class="mb-1 block text-xs font-medium text-neutral-700" for="dTitle">Title</label><input id="dTitle" class="field" style="height:36px" placeholder="Gradient hero section" required></div>
            <div><label class="mb-1 block text-xs font-medium text-neutral-700" for="dCategory">Category</label>
                <select id="dCategory" class="field" style="height:36px" required>
                    <option value="" disabled selected>Select a category</option>
                </select></div>
            <div><label class="mb-1 block text-xs font-medium text-neutral-700" for="dDesc">Description</label><textarea id="dDesc" rows="3" class="field" style="font-family:inherit" placeholder="What it is and when to use it" required></textarea></div>
            <div><label class="mb-1 block text-xs font-medium text-neutral-700" for="dTags">Tags</label><input id="dTags" class="field" style="height:36px" placeholder="hero, dark, saas (comma separated)"><p class="mt-1 text-[11px] text-neutral-500">Tags help you, AI and coding agents find it.</p></div>
            <div><label class="mb-1 block text-xs font-medium text-neutral-700" for="dProject">Project</label>
                <select id="dProject" class="field" style="height:36px"></select></div>
            <div><label class="mb-1 block text-xs font-medium text-neutral-700" for="dVis">Visibility</label>
                <select id="dVis" class="field" style="height:36px"><option value="true">Public gallery and my library</option><option value="false">My library only (private)</option></select></div>
            <p id="detailsError" class="hidden text-xs text-red-700"></p>
        </div>
        <div class="flex justify-end gap-2 border-t border-neutral-200 px-5 py-3">
            <button type="button" id="detailsCancel" class="h-9 rounded-md border border-neutral-300 px-4 text-sm font-medium hover:bg-neutral-50">Cancel</button>
            <button type="submit" id="detailsSave" class="h-9 rounded-md bg-black px-4 text-sm font-medium text-white hover:bg-neutral-800 disabled:opacity-50">Save</button>
        </div>
    </form>
</dialog>

<script id="designData" type="application/json">{{{dataJson}}}</script>
<script type="module" src="/public/js/design/editor.js"></script>
