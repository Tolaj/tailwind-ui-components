<style>
    #pageLoader { position: fixed; inset: 0; z-index: 100; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12px; background: #f5f5f5; color: #737373; font: 13px system-ui, sans-serif; transition: opacity .18s; }
    #pageLoader.is-done { opacity: 0; pointer-events: none; }
    #pageLoader i { width: 24px; height: 24px; border-radius: 50%; border: 2px solid #d4d4d4; border-top-color: #262626; animation: pgspin .8s linear infinite; }
    @keyframes pgspin { to { transform: rotate(360deg); } }
</style>
<div id="pageLoader" role="status" aria-live="polite"><i></i><span>Opening the editor…</span></div>
<script id="designData" type="application/json">{{{dataJson}}}</script>
<script type="module" src="/public/js/design-main.js"></script>
