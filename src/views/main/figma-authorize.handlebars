<div class="w-full max-w-md rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
    {{#if done}}
    <h1 class="text-xl font-semibold tracking-tight text-gray-900">{{title}}</h1>
    <p class="mt-2 text-sm text-gray-600">{{message}}</p>
    {{else}}
    <h1 class="text-xl font-semibold tracking-tight text-gray-900">Connect the Figma plugin?</h1>
    <p class="mt-2 text-sm text-gray-600">Signed in as <strong class="text-gray-900">{{userEmail}}</strong>. The plugin will be able to save the designs you send from Figma to your library.</p>
    <div class="mt-4 rounded-lg border border-gray-200 bg-gray-50 p-3 text-sm">
        <ul class="list-disc space-y-1 pl-5 text-gray-700">
            <li>Save pages to your library (private)</li>
            <li>Add fonts to the shared font library</li>
        </ul>
        <p class="mt-2 text-xs text-gray-500">It cannot delete your designs or change your account. You can sign out in the plugin at any time.</p>
    </div>
    <form method="POST" action="/figma/authorize" class="mt-5 flex gap-3">
        <input type="hidden" name="csrf" value="{{csrf}}">
        <input type="hidden" name="code" value="{{code}}">
        <button type="submit" name="decision" value="deny" class="h-10 flex-1 rounded-md border border-gray-300 text-sm font-medium text-gray-800 hover:bg-gray-50">Cancel</button>
        <button type="submit" name="decision" value="allow" class="h-10 flex-1 rounded-md bg-black text-sm font-medium text-white hover:bg-neutral-800">Allow</button>
    </form>
    {{/if}}
</div>
