<div class="flex h-screen flex-col">
    <header class="flex h-10 shrink-0 items-center gap-2 border-b border-neutral-200 bg-white px-2 text-[12px]">
        <a href="/projects" class="flex items-center gap-1 rounded-md px-2 py-1 text-neutral-600 hover:bg-neutral-100">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5"/></svg>Projects</a>
        <div class="h-5 w-px bg-neutral-200"></div>
        <button id="renameBtn" type="button" class="flex min-w-0 items-center gap-1.5 rounded-md px-2 py-1 hover:bg-neutral-100" title="Rename project">
            <span id="projName" class="truncate font-semibold text-neutral-900"></span>
            <svg class="h-3.5 w-3.5 shrink-0 text-neutral-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Z"/></svg>
        </button>
        <span id="projStats" class="text-neutral-500"></span>
        <div class="ml-auto flex items-center gap-2">
            <button id="shareBtn" type="button" class="h-7 rounded-md border border-neutral-200 px-2.5 text-xs hover:bg-neutral-50" title="A link anyone can open to look at this project and copy its code">Share</button>
            <button id="activeBtn" type="button" class="h-7 rounded-md border border-neutral-200 px-2.5 text-xs hover:bg-neutral-50" title="Claude works in the active project by default and reads its brief automatically"></button>
            <button id="tidyBtn" type="button" class="h-7 rounded-md border border-neutral-200 px-2.5 text-xs hover:bg-neutral-50" title="Reset every frame to the automatic arrangement">Tidy up</button>
            <button id="fitBtn" type="button" class="h-7 rounded-md border border-neutral-200 px-2.5 text-xs hover:bg-neutral-50" title="Zoom to fit everything (Shift+1)">Fit</button>
            <div class="flex items-center overflow-hidden rounded-md border border-neutral-200">
                <button id="zoomOut" type="button" class="h-7 w-7 hover:bg-neutral-50" title="Zoom out">−</button>
                <button id="zoomLabel" type="button" class="w-12 text-center text-[11px] text-neutral-600 hover:bg-neutral-50" title="Reset to 100%"></button>
                <button id="zoomIn" type="button" class="h-7 w-7 hover:bg-neutral-50" title="Zoom in">+</button>
            </div>
            <button id="importBtn" type="button" class="h-7 rounded-md border border-neutral-200 px-2.5 text-xs hover:bg-neutral-50" title="Add designs from HTML files, a zip, or pasted HTML">Import</button>
            <a id="newDesignBtn" href="#" class="inline-flex h-7 items-center rounded-md bg-[#0d99ff] px-3 text-xs font-semibold text-white hover:bg-[#0a84e0]" title="A new design in this project: the editor opens on a blank page">+ New design</a>
            <button id="deleteProjBtn" type="button" class="h-7 rounded-md border border-neutral-200 px-2.5 text-xs text-red-700 hover:bg-red-50">Delete project</button>
        </div>
    </header>

    <div class="flex min-h-0 flex-1">
        <aside class="flex w-60 shrink-0 flex-col border-r border-neutral-200 bg-white">
            <div class="flex border-b border-neutral-200 text-[11px] font-semibold" role="tablist">
                <button id="tabPages" type="button" role="tab" class="flex-1 whitespace-nowrap border-b-2 border-neutral-900 px-2 py-2.5 text-neutral-900">Pages</button>
                <button id="tabComponents" type="button" role="tab" class="flex-1 whitespace-nowrap border-b-2 border-transparent px-2 py-2.5 text-neutral-500 hover:text-neutral-900">Components</button>
                <button id="tabTheme" type="button" role="tab" class="flex-1 whitespace-nowrap border-b-2 border-transparent px-2 py-2.5 text-neutral-500 hover:text-neutral-900">Theme</button>
            </div>
            <div id="filters" class="space-y-1.5 border-b border-neutral-200 p-2 text-[11px]">
                <input id="fQuery" type="search" placeholder="Search" class="fi" aria-label="Search this project">
                <select id="fCat" class="fi" aria-label="Category"><option value="">All categories</option></select>
                <div id="fTags" class="flex flex-wrap gap-1"></div>
            </div>
            <div id="outline" class="min-h-0 flex-1 overflow-auto p-1 text-[11px]"></div>
            <div id="themePanel" class="hidden min-h-0 flex-1 overflow-auto p-3 text-[11px]"></div>
        </aside>

        <main id="board" class="relative min-w-0 flex-1 overflow-hidden bg-[#e5e5e5]" style="cursor:grab;touch-action:none;user-select:none">
            <div id="world" style="position:absolute;left:0;top:0;transform-origin:0 0;will-change:transform"></div>
            <div id="boardEmpty" class="pointer-events-none absolute inset-0 hidden items-center justify-center">
                <div class="max-w-md rounded-xl border border-dashed border-neutral-400 bg-white/70 p-8 text-center">
                    <h2 class="text-sm font-semibold text-neutral-900">This project is empty</h2>
                    <p class="mt-1 text-xs text-neutral-600">Press <strong>+ New design</strong>, or ask Claude to design a page and save it into this project.</p>
                </div>
            </div>
            <p class="pointer-events-none absolute bottom-2 left-1/2 -translate-x-1/2 rounded-full bg-white/80 px-3 py-1 text-[11px] text-neutral-500">Drag the background to pan, scroll to pan, Ctrl/Cmd + scroll to zoom, drag a frame to move it, double-click to open it</p>
        </main>

        <aside class="flex w-72 shrink-0 flex-col border-l border-neutral-200 bg-white">
            <div id="details" class="min-h-0 flex-1 overflow-auto p-3 text-[11px]"></div>
        </aside>
    </div>
</div>

{{!-- Export / history modal --}}
<dialog id="libModal" class="m-auto w-[min(860px,92vw)] rounded-xl border border-gray-200 p-0 shadow-[0_16px_48px_rgba(0,0,0,0.2)] backdrop:bg-black/40">
    <div class="flex items-center justify-between border-b border-gray-200 px-5 py-3">
        <h3 id="libModalTitle" class="text-sm font-semibold text-gray-900"></h3>
        <button type="button" id="libModalClose" class="h-7 w-7 rounded text-gray-500 hover:bg-gray-100" aria-label="Close">✕</button>
    </div>
    <div class="flex items-center gap-1 border-b border-gray-200 px-4 py-2" id="libTabs"></div>
    <div class="relative">
        <button type="button" id="libCopy" class="absolute right-3 top-3 hidden h-7 rounded-md border border-gray-300 bg-white px-2.5 text-xs font-medium hover:bg-gray-50">Copy</button>
        <pre id="libCode" class="max-h-[60vh] overflow-auto whitespace-pre-wrap break-words bg-gray-50 p-5 font-mono text-[12px] leading-5 text-gray-900"></pre>
        <div id="libHistory" class="hidden max-h-[60vh] overflow-auto divide-y divide-gray-100"></div>
    </div>
</dialog>

{{!-- Import modal --}}
<dialog id="importModal" class="m-auto w-[min(640px,92vw)] rounded-xl border border-gray-200 p-0 shadow-[0_16px_48px_rgba(0,0,0,0.2)] backdrop:bg-black/40">
    <div class="flex items-center justify-between border-b border-gray-200 px-5 py-3">
        <h3 class="text-sm font-semibold text-gray-900">Import designs</h3>
        <button type="button" id="importClose" class="h-7 w-7 rounded text-gray-500 hover:bg-gray-100" aria-label="Close">✕</button>
    </div>
    <div class="space-y-4 p-5">
        <label id="dropZone" class="block cursor-pointer rounded-lg border-2 border-dashed border-gray-300 p-8 text-center transition-colors hover:border-gray-500">
            <span class="block text-sm font-medium text-gray-900">Drop HTML or .zip files here</span>
            <span class="mt-1 block text-xs text-gray-500">or click to choose. A zip can hold many pages.</span>
            <input type="file" id="importInput" accept=".html,.htm,.zip,text/html,application/zip" multiple class="hidden">
        </label>
        <ul id="importFiles" class="hidden max-h-28 divide-y divide-gray-100 overflow-auto rounded-lg border border-gray-200 text-sm"></ul>

        <div>
            <p class="mb-1.5 text-xs font-medium text-gray-600">Or paste HTML</p>
            <input id="pasteTitle" type="text" placeholder="Name (optional)" class="mb-2 h-9 w-full rounded-md border border-gray-300 px-3 text-sm placeholder-gray-400 focus:border-gray-900 focus:outline-none focus:ring-1 focus:ring-gray-900">
            <textarea id="pasteHtml" rows="5" spellcheck="false" placeholder="<!doctype html> ..." class="w-full rounded-md border border-gray-300 p-3 font-mono text-[12px] leading-5 placeholder-gray-400 focus:border-gray-900 focus:outline-none focus:ring-1 focus:ring-gray-900"></textarea>
        </div>

        <label class="flex cursor-pointer items-start gap-2 text-sm text-gray-700">
            <input id="splitToggle" type="checkbox" checked class="mt-1 h-4 w-4 rounded border-gray-300 accent-black">
            <span><strong class="text-gray-900">Split pages into sections.</strong> Each page is saved whole, and its header, hero, pricing, footer and so on are saved as separate components you can reuse.</span>
        </label>
        <p id="importStatus" class="hidden text-sm"></p>
    </div>
    <div class="flex justify-end gap-2 border-t border-gray-200 px-5 py-3">
        <button type="button" id="importCancel" class="h-9 rounded-md border border-gray-300 px-4 text-sm font-medium text-gray-800 hover:bg-gray-50">Cancel</button>
        <button type="button" id="importGo" class="h-9 rounded-md bg-black px-4 text-sm font-medium text-white hover:bg-neutral-800 disabled:opacity-50">Import</button>
    </div>
</dialog>


<script>window.__PROJECT_ID = "{{projectId}}";</script>
<script id="projectData" type="application/json">{{{dataJson}}}</script>
<script type="module" src="/public/js/project-board.js"></script>
<script type="module" src="/public/js/import-modal.js"></script>
