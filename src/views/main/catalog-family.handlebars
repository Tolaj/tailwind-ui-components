<div class="max-w-7xl flex-1 mx-auto p-6" data-signed-in="{{#if user}}1{{/if}}">
    <a href="/catalog" class="text-sm text-gray-500 hover:text-gray-900">&larr; Catalog</a>
    <div class="mt-2 mb-6">
        <h1 class="text-4xl font-bold text-gray-900 mb-2">{{name}}</h1>
        <p class="text-gray-600 max-w-2xl">{{description}}</p>
    </div>

    {{!-- Theme and dark: what every preview below uses --}}
    <div class="mb-6 flex flex-wrap items-end gap-x-6 gap-y-3 rounded-xl border border-gray-200 bg-white p-4 text-sm">
        <label class="block"><span class="mb-1 block text-xs font-medium text-gray-500">Brand</span><span class="flex items-center gap-2"><input id="thBrand" type="color" value="#4f46e5" class="h-8 w-10 cursor-pointer rounded border border-gray-200 p-0.5"><input id="thBrandHex" value="#4f46e5" maxlength="7" spellcheck="false" class="h-8 w-24 rounded-md border border-gray-300 px-2 font-mono text-xs"></span></label>
        <label class="block"><span class="mb-1 block text-xs font-medium text-gray-500">Gray</span><select id="thGray" class="h-8 rounded-md border border-gray-300 px-2 text-sm"></select></label>
        <label class="block"><span class="mb-1 block text-xs font-medium text-gray-500">Corners</span><select id="thRadius" class="h-8 rounded-md border border-gray-300 px-2 text-sm"></select></label>
        <label class="block"><span class="mb-1 block text-xs font-medium text-gray-500">Font</span><input id="thFont" list="thFonts" value="Inter" class="h-8 w-40 rounded-md border border-gray-300 px-2 text-sm"><datalist id="thFonts"></datalist></label>
        <button id="darkToggle" type="button" class="ml-auto h-8 rounded-md border border-gray-300 px-3 text-sm font-medium text-gray-800 hover:bg-gray-50" aria-pressed="false">Dark</button>
    </div>

    {{!-- One part, customised: pick, see it, copy it --}}
    <section class="mb-10 grid gap-4 lg:grid-cols-2">
        <div class="rounded-xl border border-gray-200 bg-white p-4">
            <div id="pickers" class="mb-3 flex flex-wrap gap-3 text-sm"></div>
            <iframe id="mainPreview" title="Preview" class="h-40 w-full rounded-lg border border-gray-100"></iframe>
            <div class="mt-3 flex flex-wrap items-center gap-2" id="addBox"></div>
        </div>
        <div class="rounded-xl border border-gray-200 bg-white">
            <div class="flex items-center gap-1 border-b border-gray-100 px-2 pt-2" id="codeTabs" role="tablist"></div>
            <pre class="max-h-[22rem] overflow-auto p-4 text-xs leading-5 text-gray-800"><code id="codeBox"></code></pre>
            <div class="flex items-center justify-between border-t border-gray-100 px-3 py-2">
                <button id="copyBtn" type="button" class="h-8 rounded-md bg-black px-3 text-xs font-semibold text-white hover:bg-neutral-800">Copy</button>
                <button id="setupBtn" type="button" class="text-xs text-gray-500 underline-offset-2 hover:text-gray-900 hover:underline">Theme setup for Tailwind</button>
            </div>
            <pre id="setupBox" class="hidden max-h-60 overflow-auto border-t border-gray-100 bg-gray-50 p-4 text-xs leading-5 text-gray-700"></pre>
        </div>
    </section>

    <div id="sections" class="space-y-10"></div>
</div>
<script id="catalogMeta" type="application/json">{{{metaJson}}}</script>
<script type="module" src="/public/js/catalog.js"></script>
