<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}} — Windcraft</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="/public/js/tailwind.config.js"></script>
    <style>
        html, body { height: 100%; }
        body { margin: 0; overflow: hidden; background: #f5f5f5; font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif; }
        .layer-row.is-selected { background: #eff6ff; color: #1d4ed8; }
        .layer-row.drop-before { box-shadow: inset 0 2px 0 #2563eb; }
        .layer-row.drop-after { box-shadow: inset 0 -2px 0 #2563eb; }
        .layer-row.drop-inside { background: #dbeafe; }
        .swatch { width: 18px; height: 18px; border-radius: 4px; border: 1px solid rgba(0,0,0,.12); }
        .swatch-t { background: repeating-conic-gradient(#ddd 0 25%, #fff 0 50%) 0 0 / 8px 8px; }
        .swatch.is-on { outline: 2px solid #2563eb; outline-offset: 1px; }
        .seg button.is-on { background: #111; color: #fff; }
        .field { height: 30px; width: 100%; border: 1px solid #d4d4d4; border-radius: 6px; background: #fff; padding: 0 8px; font-size: 12px; }
        .field:focus { outline: none; border-color: #111; }
        textarea.field { height: auto; padding: 6px 8px; font-family: ui-monospace, monospace; }
    </style>
</head>

<body>
    {{{body}}}
</body>

</html>
