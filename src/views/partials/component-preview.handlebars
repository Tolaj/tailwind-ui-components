<div class="w-full rounded-2xl" data-component-id="{{_id}}">

    <!-- Header -->
    <div class="flex items-center justify-between mb-2">

        <!-- Left Title -->
        <div>
            <h2 class="text-xl font-semibold text-gray-900">{{title}}</h2>
            {{#if description}}
            <p class="text-sm text-gray-500 mt-1">{{description}}</p>
            {{/if}}
        </div>

        <!-- Right Controls -->
        <div class="flex items-center gap-2">

            <!-- Preview / Code Toggle -->
            <div class="flex items-center bg-gray-200 rounded-full p-1">
                <button onclick="toggleTab('{{_id}}','preview')" id="preview-btn-{{_id}}"
                    class="px-3 py-1 text-xs font-medium rounded-full bg-white shadow text-gray-900">
                    Preview
                </button>
                <button onclick="toggleTab('{{_id}}','code')" id="code-btn-{{_id}}"
                    class="px-3 py-1 text-xs font-medium rounded-full text-gray-600">
                    Code
                </button>
            </div>

            <div class="h-4 w-px bg-gray-300"></div>

            <!-- Device: Desktop (default), Tablet or Mobile; the last two show the component in a device frame -->
            <div class="relative">
                <button onclick="toggleViewSize('{{_id}}')" id="size-btn-{{_id}}" aria-haspopup="menu"
                    class="p-1.5 rounded-md hover:bg-gray-200 text-gray-600" title="Desktop view (change the device)">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5"><rect x="3" y="4" width="18" height="12" rx="2" stroke-linecap="round" stroke-linejoin="round"/><path stroke-linecap="round" stroke-linejoin="round" d="M8 20h8M12 16v4"/></svg>
                </button>
                <div id="size-menu-{{_id}}" role="menu"
                    class="hidden absolute right-0 top-full z-30 mt-1 w-[280px] rounded-xl border border-gray-200 bg-white p-1.5 shadow-lg">
                    <div class="px-2.5 pb-1 pt-2 text-[11px] text-gray-500">Device</div>
                    <button type="button" role="menuitem" data-device="desktop" onclick="setViewDevice('{{_id}}', 'desktop')"
                        class="flex h-[34px] w-full items-center gap-2.5 rounded-lg px-2.5 text-[13px] text-gray-900 hover:bg-gray-100 bg-gray-100">
                        <span data-tick style="visibility:visible"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4"><path stroke-linecap="round" stroke-linejoin="round" d="m5 12 5 5L20 7"/></svg></span>
                        <span class="text-gray-500"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5"><rect x="3" y="4" width="18" height="12" rx="2" stroke-linecap="round" stroke-linejoin="round"/><path stroke-linecap="round" stroke-linejoin="round" d="M8 20h8M12 16v4"/></svg></span><span class="flex-1 text-left">Desktop</span><span class="text-xs text-neutral-500">Full width</span>
                    </button>
                    <button type="button" role="menuitem" data-device="tablet" onclick="setViewDevice('{{_id}}', 'tablet')"
                        class="flex h-[34px] w-full items-center gap-2.5 rounded-lg px-2.5 text-[13px] text-gray-900 hover:bg-gray-100">
                        <span data-tick style="visibility:hidden"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4"><path stroke-linecap="round" stroke-linejoin="round" d="m5 12 5 5L20 7"/></svg></span>
                        <span class="text-gray-500"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5"><rect x="5" y="3" width="14" height="18" rx="2" stroke-linecap="round" stroke-linejoin="round"/><path stroke-linecap="round" d="M11 18h2"/></svg></span><span class="flex-1 text-left">Tablet</span><span class="text-xs text-neutral-500">768</span>
                    </button>
                    <button type="button" role="menuitem" data-device="mobile" onclick="setViewDevice('{{_id}}', 'mobile')"
                        class="flex h-[34px] w-full items-center gap-2.5 rounded-lg px-2.5 text-[13px] text-gray-900 hover:bg-gray-100">
                        <span data-tick style="visibility:hidden"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4"><path stroke-linecap="round" stroke-linejoin="round" d="m5 12 5 5L20 7"/></svg></span>
                        <span class="text-gray-500"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5"><rect x="7" y="3" width="10" height="18" rx="2" stroke-linecap="round" stroke-linejoin="round"/><path stroke-linecap="round" d="M11 18h2"/></svg></span><span class="flex-1 text-left">Mobile</span><span class="text-xs text-neutral-500">390</span>
                    </button>
                </div>
            </div>

            <!-- Theme Toggle (Light default) -->
            <button onclick="toggleTheme('{{_id}}')" id="theme-btn-{{_id}}"
                class="p-1.5 rounded-md hover:bg-gray-200 text-gray-600" title="Toggle light/dark theme">
                <svg id="theme-icon-{{_id}}" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5"
                    viewBox="0 0 24 24">
                    <circle cx="12" cy="12" r="4" />
                    <path stroke-linecap="round" stroke-linejoin="round"
                        d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32l1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41m11.32-11.32l1.41-1.41" />
                </svg>
            </button>

            <!-- Fullscreen -->
            <button onclick="toggleComponentFullscreen('{{_id}}')"
                class="p-1.5 rounded-md hover:bg-gray-200 text-gray-600" title="Fullscreen">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
                    stroke="currentColor" class="w-5 h-5">
                    <path stroke-linecap="round" stroke-linejoin="round"
                        d="M3.75 3.75v4.5m0-4.5h4.5m-4.5 0L9 9M3.75 20.25v-4.5m0 4.5h4.5m-4.5 0L9 15M20.25 3.75h-4.5m4.5 0v4.5m0-4.5L15 9m5.25 11.25h-4.5m4.5 0v-4.5m0 4.5L15 15" />
                </svg>
            </button>

            <div class="h-4 w-px bg-gray-300"></div>

            <!-- Language -->
            <select class="text-sm font-medium bg-transparent focus:outline-none text-gray-700">
                <option>HTML</option>
            </select>

            <!-- Save into a project, or open a copy in the editor. Signed out, both ask you to sign in and then carry on -->
            {{#unless savedId}}
            <button type="button" onclick="chooseProject('{{_id}}', 'save', this)" data-card-action="save" data-card-id="{{_id}}" data-signed-in="{{#if @root.user}}1{{/if}}"
                title="Save a private copy in one of your projects"
                class="h-8 rounded-md border border-gray-300 px-2.5 text-xs font-medium text-gray-800 hover:bg-gray-100 whitespace-nowrap">Save</button>
            {{/unless}}
            <button type="button" onclick="chooseProject('{{_id}}', 'edit', this)" data-card-action="edit" data-card-id="{{_id}}" data-saved-id="{{savedId}}" data-signed-in="{{#if @root.user}}1{{/if}}"
                title="Make your own copy in a project and open it in the editor"
                class="h-8 rounded-md bg-black px-2.5 text-xs font-medium text-white hover:bg-neutral-800 whitespace-nowrap">Open in editor</button>

            <!-- Copy -->
            <button onclick="copyCode('{{_id}}')" id="copy-btn-{{_id}}"
                class="p-1.5 rounded-md hover:bg-gray-200 text-gray-600" title="Copy code">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                    <rect x="9" y="9" width="13" height="13" rx="2" />
                    <path d="M5 15V5a2 2 0 012-2h10" />
                </svg>
            </button>

        </div>
    </div>

    <!-- Preview Panel -->
    <div id="preview-{{_id}}" class="bg-white border border-gray-200 rounded-xl transition-all duration-300"
        style="position: relative; overflow: hidden;">
        <div id="preview-inner-{{_id}}" class="w-full transition-all duration-300"
            style="position: relative; min-height: 200px; contain: layout style;">
            <!-- Content rendered by category.js -->
        </div>
    </div>

    <!-- Code Panel -->
    <div id="code-{{_id}}" class="hidden">
        <div class="bg-slate-900 rounded-xl p-6 overflow-auto" style="height: 400px;">
            <pre
                class="text-sm text-slate-300 leading-relaxed whitespace-pre"><code id="code-content-{{_id}}">{{htmlCode}}</code></pre>
        </div>
    </div>

</div>