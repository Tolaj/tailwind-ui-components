<!-- Settings Modal -->
<div id="settingsModal" class="hidden fixed inset-0 z-50">
    <div class="fixed inset-0 bg-gray-500/75" onclick="closeSettingsModal()"></div>
    <div class="flex items-center justify-center min-h-full p-4">
        <div class="relative bg-white rounded-2xl shadow-xl w-full max-w-lg border border-gray-300 z-10">

            <!-- Header -->
            <div class="flex items-center justify-between px-6 py-4 border-b border-gray-200">
                <div class="flex items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
                        stroke="currentColor" class="size-5 text-gray-700">
                        <path stroke-linecap="round" stroke-linejoin="round"
                            d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.325.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 0 1 1.37.49l1.296 2.247a1.125 1.125 0 0 1-.26 1.431l-1.003.827c-.293.241-.438.613-.43.992a7.723 7.723 0 0 1 0 .255c-.008.378.137.75.43.991l1.004.827c.424.35.534.955.26 1.43l-1.298 2.247a1.125 1.125 0 0 1-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.47 6.47 0 0 1-.22.128c-.331.183-.581.495-.644.869l-.213 1.281c-.09.543-.56.94-1.11.94h-2.594c-.55 0-1.019-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 0 1-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 0 1-1.369-.49l-1.297-2.247a1.125 1.125 0 0 1 .26-1.431l1.004-.827c.292-.24.437-.613.43-.991a6.932 6.932 0 0 1 0-.255c.007-.38-.138-.751-.43-.992l-1.004-.827a1.125 1.125 0 0 1-.26-1.43l1.297-2.247a1.125 1.125 0 0 1 1.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.086.22-.128.332-.183.582-.495.644-.869l.214-1.28Z" />
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                    </svg>
                    <h2 class="text-lg font-semibold text-gray-900">AI Settings</h2>
                </div>
                <button onclick="closeSettingsModal()" class="p-1 rounded-lg hover:bg-gray-100 text-gray-400 hover:text-gray-600">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <!-- Body -->
            <div class="px-6 py-5 space-y-6">

                <!-- Enable/Disable Toggle -->
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm font-medium text-gray-900">Enable AI Generation</p>
                        <p class="text-xs text-gray-500 mt-0.5">Show AI prompt in the component editor</p>
                    </div>
                    <button id="llmToggle" type="button" onclick="toggleLlmEnabled()" role="switch"
                        class="relative inline-flex h-6 w-11 shrink-0 cursor-pointer rounded-full border-2 border-transparent bg-gray-200 transition-colors duration-200 focus:outline-none">
                        <span id="llmToggleKnob"
                            class="pointer-events-none inline-block h-5 w-5 translate-x-0 rounded-full bg-white shadow ring-0 transition duration-200"></span>
                    </button>
                </div>

                <!-- Provider Selection -->
                <div id="providerSection" class="space-y-3">
                    <p class="text-sm font-medium text-gray-900">Provider</p>
                    <div class="grid grid-cols-2 gap-3">
                        <button id="providerAnthropicBtn" type="button" onclick="selectProvider('anthropic')"
                            class="flex items-center gap-3 px-4 py-3 rounded-xl border-2 text-left transition-all">
                            <div class="h-8 w-8 rounded-lg bg-orange-100 flex items-center justify-center shrink-0">
                                <span class="text-sm font-bold text-orange-600">A</span>
                            </div>
                            <div>
                                <p class="text-sm font-medium text-gray-900">Anthropic</p>
                                <p class="text-xs text-gray-500">Claude API</p>
                            </div>
                        </button>
                        <button id="providerLocalBtn" type="button" onclick="selectProvider('local')"
                            class="flex items-center gap-3 px-4 py-3 rounded-xl border-2 text-left transition-all">
                            <div class="h-8 w-8 rounded-lg bg-green-100 flex items-center justify-center shrink-0">
                                <span class="text-sm font-bold text-green-600">L</span>
                            </div>
                            <div>
                                <p class="text-sm font-medium text-gray-900">Local LLM</p>
                                <p class="text-xs text-gray-500">Self-hosted</p>
                            </div>
                        </button>
                    </div>
                </div>

                <!-- Anthropic API Key Input -->
                <div id="anthropicSection" class="hidden space-y-2">
                    <label class="block text-sm font-medium text-gray-700">Anthropic API Key</label>
                    <input type="password" id="anthropicKeyInput" placeholder="sk-ant-..."
                        class="w-full px-3.5 py-2.5 text-sm text-gray-900 placeholder-gray-400 bg-white border border-gray-300 rounded-xl focus:border-gray-900 focus:ring-1 focus:ring-gray-900 focus:outline-none transition-colors" />
                    <p id="anthropicKeyStatus" class="text-xs text-gray-500"></p>
                </div>

                <!-- Local LLM URL Input -->
                <div id="localSection" class="hidden space-y-2">
                    <label class="block text-sm font-medium text-gray-700">Local LLM URL</label>
                    <input type="url" id="localUrlInput" placeholder="http://localhost:5001"
                        class="w-full px-3.5 py-2.5 text-sm text-gray-900 placeholder-gray-400 bg-white border border-gray-300 rounded-xl focus:border-gray-900 focus:ring-1 focus:ring-gray-900 focus:outline-none transition-colors" />
                    <p class="text-xs text-gray-500">Must expose an OpenAI-compatible /v1/chat/completions endpoint</p>
                </div>
            </div>

            <!-- Footer -->
            <div class="px-6 py-4 border-t border-gray-200 flex justify-end gap-3">
                <button onclick="closeSettingsModal()"
                    class="px-4 py-2 text-sm font-medium text-gray-700 border border-gray-300 rounded-xl hover:bg-gray-50 transition-colors">
                    Cancel
                </button>
                <button onclick="saveSettings()"
                    class="px-4 py-2 text-sm font-medium text-white bg-primary rounded-xl hover:opacity-90 transition-all">
                    Save
                </button>
            </div>

        </div>
    </div>
</div>
