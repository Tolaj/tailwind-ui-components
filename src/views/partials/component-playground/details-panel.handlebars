{{!-- Details: shown over the editor when the first save needs a name (the editor asks, this answers) --}}
<div id="detailsPanel" class="absolute inset-0 z-30 hidden items-center justify-center bg-neutral-900/30 p-4 backdrop-blur-[2px] sm:p-8">
    <div role="dialog" aria-labelledby="detailsHeading" class="flex max-h-full w-full max-w-xl flex-col overflow-hidden rounded-2xl border border-neutral-200 bg-white shadow-[0_24px_64px_rgba(0,0,0,0.25)]">
        <div class="border-b border-neutral-100 px-6 pb-4 pt-5">
            <h3 id="detailsHeading" class="text-lg font-semibold tracking-[-0.02em] text-neutral-900">Name your component</h3>
            <p class="mt-0.5 text-[13px] text-neutral-500">A few details so you and your team can find it later.</p>
        </div>
        <div class="grid min-h-0 flex-1 grid-cols-1 gap-x-4 gap-y-4 overflow-y-auto px-6 py-5 sm:grid-cols-2">
            <div class="space-y-1.5 sm:col-span-2">
                <label for="title" class="block text-[13px] font-medium text-neutral-800">Title</label>
                <input type="text" id="title" name="title" placeholder="Gradient hero section" class="h-10 w-full rounded-md border border-neutral-300 bg-white px-3 text-sm text-neutral-900 placeholder-neutral-400 transition-colors focus:border-neutral-900 focus:outline-none focus:ring-1 focus:ring-neutral-900" required>
            </div>
            <div class="space-y-1.5">
                <label for="category" class="block text-[13px] font-medium text-neutral-800">Category</label>
                <select id="category" name="category" class="h-10 w-full rounded-md border border-neutral-300 bg-white px-3 text-sm text-neutral-900 placeholder-neutral-400 transition-colors focus:border-neutral-900 focus:outline-none focus:ring-1 focus:ring-neutral-900" required>
                    <option value="" disabled selected class="text-gray-400">Select a category</option>
                    <optgroup label="Marketing">
                        <option value="marketing-hero">Hero Sections</option>
                        <option value="marketing-hero-forms">Hero Forms</option>
                        <option value="marketing-icons">Icon Sections</option>
                        <option value="marketing-pricing">Pricing Sections</option>
                        <option value="marketing-faq">FAQ Sections</option>
                        <option value="marketing-blog">Blog Sections</option>
                        <option value="marketing-testimonials">Testimonials</option>
                        <option value="marketing-team">Team Sections</option>
                        <option value="marketing-features">Features</option>
                        <option value="marketing-announcements">Announcement Banners</option>
                        <option value="marketing-cards">Card Sections</option>
                        <option value="marketing-clients">Clients Sections</option>
                        <option value="marketing-galleries">Galleries</option>
                        <option value="marketing-timeline">Timeline</option>
                    </optgroup>
                    <optgroup label="UI Components">
                        <option value="ui-dropdowns">Dropdowns</option>
                        <option value="ui-selects">Selects</option>
                        <option value="ui-buttons">Button Groups</option>
                        <option value="ui-modals">Modals</option>
                        <option value="ui-cookie-banners">Cookie Banners</option>
                    </optgroup>
                    <optgroup label="Navigation">
                        <option value="navigation-navbars">Navbars / Headers</option>
                        <option value="navigation-mega-menu">Mega Menu</option>
                    </optgroup>
                    <optgroup label="Layout">
                        <option value="layout-basic">Layouts</option>
                    </optgroup>
                    <optgroup label="Forms">
                        <option value="forms-authentication">Authentication</option>
                        <option value="forms-feedback">Feedback</option>
                        <option value="forms-subscribe">Subscribe</option>
                        <option value="forms-textarea">Textarea Inputs</option>
                    </optgroup>
                    <optgroup label="Pages">
                        <option value="pages-pricing">Pricing Page</option>
                    </optgroup>
                    <optgroup label="E-Commerce">
                        <option value="ecommerce-products">Product Listings</option>
                    </optgroup>
                    <optgroup label="Applications">
                        <option value="apps-general">Application Components</option>
                        <option value="apps-invoice">Invoice</option>
                        <option value="apps-tables">Tables</option>
                        <option value="apps-stats">Stats</option>
                        <option value="apps-charts">Charts</option>
                        <option value="apps-ai-prompt">AI Prompt</option>
                    </optgroup>
                    <optgroup label="Footer">
                        <option value="footer-contact">Contact Sections</option>
                        <option value="footer-footers">Footers</option>
                    </optgroup>
                </select>
            </div>
            <div class="space-y-1.5">
                <label for="project" class="block text-[13px] font-medium text-neutral-800">Project</label>
                <div id="projectBox" class="relative">
                    <input type="text" id="project" name="project" required autocomplete="off" role="combobox" aria-expanded="false" aria-controls="projectList"
                        placeholder="Choose or create a project" maxlength="80"
                        class="h-10 w-full rounded-md border border-neutral-300 bg-white px-3 pr-9 text-sm text-neutral-900 placeholder-neutral-400 transition-colors focus:border-neutral-900 focus:outline-none focus:ring-1 focus:ring-neutral-900">
                    <svg class="pointer-events-none absolute right-3 top-3 h-4 w-4 text-neutral-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m6 9 6 6 6-6"/></svg>
                    <ul id="projectList" role="listbox" class="absolute left-0 right-0 z-10 mt-1 hidden max-h-48 overflow-auto rounded-md border border-neutral-200 bg-white p-1 text-sm shadow-[0_8px_24px_rgba(0,0,0,0.12)]"></ul>
                </div>
            </div>
            <div class="space-y-1.5 sm:col-span-2">
                <label for="description" class="block text-[13px] font-medium text-neutral-800">Description</label>
                <textarea id="description" name="description" rows="3" placeholder="Describe what this component does and when to use it"
                    class="w-full rounded-md border border-neutral-300 bg-white px-3 text-sm text-neutral-900 placeholder-neutral-400 transition-colors focus:border-neutral-900 focus:outline-none focus:ring-1 focus:ring-neutral-900 py-2.5 resize-none" required></textarea>
            </div>
            <div class="space-y-1.5 ">
                <label for="tags" class="block text-[13px] font-medium text-neutral-800">Tags</label>
                <input type="text" id="tags" name="tags" placeholder="hero, dark, saas (comma separated)" class="h-10 w-full rounded-md border border-neutral-300 bg-white px-3 text-sm text-neutral-900 placeholder-neutral-400 transition-colors focus:border-neutral-900 focus:outline-none focus:ring-1 focus:ring-neutral-900">
                <p class="text-xs text-neutral-500">Tags make components easy to find, and help AI and coding agents pick the right one.</p>
            </div>
            <div class="space-y-1.5">
                <label for="isPublished" class="block text-[13px] font-medium text-neutral-800">Visibility</label>
                <select id="isPublished" name="isPublished" class="h-10 w-full rounded-md border border-neutral-300 bg-white px-3 text-sm text-neutral-900 placeholder-neutral-400 transition-colors focus:border-neutral-900 focus:outline-none focus:ring-1 focus:ring-neutral-900">
                    <option value="true">Public gallery and my library</option>
                    <option value="false">My library only (private)</option>
                </select>
            </div>
            <p id="detailsError" class="hidden text-[13px] text-red-700 sm:col-span-2"></p>
        </div>
        <div class="flex items-center justify-end gap-2 border-t border-neutral-100 bg-neutral-50 px-6 py-3">
            <button id="detailsBack" type="button" onclick="handleBack()" class="h-9 rounded-md border border-neutral-300 bg-white px-3.5 text-[13px] font-medium text-neutral-800 transition-colors hover:border-neutral-400 hover:bg-neutral-50">Back to editor</button>
            <button id="submitBtn" type="submit" class="h-9 rounded-md bg-black px-4 text-[13px] font-medium text-white transition-colors hover:bg-neutral-800 disabled:opacity-50">Publish</button>
        </div>
    </div>
</div>
