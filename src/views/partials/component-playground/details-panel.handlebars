{{!-- Details: a small form that drops under the editor's Save toolbar when the first save needs a name (the editor asks, this answers) --}}
<div id="detailsPanel" role="region" aria-labelledby="detailsHeading" class="absolute right-3 top-[66px] z-30 hidden w-[340px] max-w-[calc(100%-1.5rem)] flex-col rounded-2xl border border-neutral-200/80 bg-white shadow-[0_6px_24px_rgba(0,0,0,0.14)]">
    <div class="flex items-center justify-between px-4 pb-1 pt-3">
        <h3 id="detailsHeading" class="text-[13px] font-semibold text-neutral-900">Name your component</h3>
        <button id="detailsBack" type="button" onclick="handleBack()" title="Back to the editor" aria-label="Back to the editor" class="flex h-6 w-6 items-center justify-center rounded text-neutral-500 hover:bg-neutral-100">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"/></svg>
        </button>
    </div>
    <div class="grid max-h-[calc(100vh-17rem)] grid-cols-2 gap-x-2.5 gap-y-2.5 overflow-y-auto px-4 py-2">
            <div class="space-y-1 col-span-2">
                <label for="title" class="block text-[12px] font-medium text-neutral-600">Title</label>
                <input type="text" id="title" name="title" placeholder="Gradient hero section" class="h-8 w-full rounded-md border border-neutral-300 bg-white px-2.5 text-[13px] text-neutral-900 placeholder-neutral-400 transition-colors focus:border-neutral-900 focus:outline-none focus:ring-1 focus:ring-neutral-900" required>
            </div>
            <div class="space-y-1">
                <label for="category" class="block text-[12px] font-medium text-neutral-600">Category</label>
                <select id="category" name="category" class="h-8 w-full rounded-md border border-neutral-300 bg-white px-2.5 text-[13px] text-neutral-900 placeholder-neutral-400 transition-colors focus:border-neutral-900 focus:outline-none focus:ring-1 focus:ring-neutral-900" required>
                    <option value="" disabled selected class="text-gray-400">Select a category</option>
                    <optgroup label="Marketing">
                        <option value="marketing-hero">Hero Sections</option>
                        <option value="marketing-hero-forms">Hero Forms</option>
                        <option value="marketing-icons">Icon Sections</option>
                        <option value="marketing-pricing">Pricing Sections</option>
                        <option value="marketing-faq">FAQ Sections</option>
                        <option value="marketing-blog">Blog Sections</option>
                        <option value="marketing-testimonials">Testimonials</option>
                        <option value="marketing-team">Team Sections</option>
                        <option value="marketing-features">Features</option>
                        <option value="marketing-announcements">Announcement Banners</option>
                        <option value="marketing-cards">Card Sections</option>
                        <option value="marketing-clients">Clients Sections</option>
                        <option value="marketing-galleries">Galleries</option>
                        <option value="marketing-timeline">Timeline</option>
                    </optgroup>
                    <optgroup label="UI Components">
                        <option value="ui-dropdowns">Dropdowns</option>
                        <option value="ui-selects">Selects</option>
                        <option value="ui-buttons">Button Groups</option>
                        <option value="ui-modals">Modals</option>
                        <option value="ui-cookie-banners">Cookie Banners</option>
                    </optgroup>
                    <optgroup label="Navigation">
                        <option value="navigation-navbars">Navbars / Headers</option>
                        <option value="navigation-mega-menu">Mega Menu</option>
                    </optgroup>
                    <optgroup label="Layout">
                        <option value="layout-basic">Layouts</option>
                    </optgroup>
                    <optgroup label="Forms">
                        <option value="forms-authentication">Authentication</option>
                        <option value="forms-feedback">Feedback</option>
                        <option value="forms-subscribe">Subscribe</option>
                        <option value="forms-textarea">Textarea Inputs</option>
                    </optgroup>
                    <optgroup label="Pages">
                        <option value="pages-pricing">Pricing Page</option>
                    </optgroup>
                    <optgroup label="E-Commerce">
                        <option value="ecommerce-products">Product Listings</option>
                    </optgroup>
                    <optgroup label="Applications">
                        <option value="apps-general">Application Components</option>
                        <option value="apps-invoice">Invoice</option>
                        <option value="apps-tables">Tables</option>
                        <option value="apps-stats">Stats</option>
                        <option value="apps-charts">Charts</option>
                        <option value="apps-ai-prompt">AI Prompt</option>
                    </optgroup>
                    <optgroup label="Footer">
                        <option value="footer-contact">Contact Sections</option>
                        <option value="footer-footers">Footers</option>
                    </optgroup>
                </select>
            </div>
            <div class="space-y-1">
                <label for="project" class="block text-[12px] font-medium text-neutral-600">Project</label>
                <div id="projectBox" class="relative">
                    <input type="text" id="project" name="project" required autocomplete="off" role="combobox" aria-expanded="false" aria-controls="projectList"
                        placeholder="Choose or create a project" maxlength="80"
                        class="h-8 w-full rounded-md border border-neutral-300 bg-white px-2.5 pr-8 text-[13px] text-neutral-900 placeholder-neutral-400 transition-colors focus:border-neutral-900 focus:outline-none focus:ring-1 focus:ring-neutral-900">
                    <svg class="pointer-events-none absolute right-2.5 top-2 h-4 w-4 text-neutral-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m6 9 6 6 6-6"/></svg>
                    <ul id="projectList" role="listbox" class="absolute z-40 hidden max-h-48 overflow-auto rounded-md border border-neutral-200 bg-white p-1 text-[13px] shadow-[0_8px_24px_rgba(0,0,0,0.12)]"></ul>
                </div>
            </div>
            <div class="space-y-1 col-span-2">
                <label for="description" class="block text-[12px] font-medium text-neutral-600">Description</label>
                <textarea id="description" name="description" rows="2" placeholder="Describe what this component does and when to use it"
                    class="w-full rounded-md border border-neutral-300 bg-white px-2.5 text-[13px] text-neutral-900 placeholder-neutral-400 transition-colors focus:border-neutral-900 focus:outline-none focus:ring-1 focus:ring-neutral-900 py-2.5 resize-none" required></textarea>
            </div>
            <div class="space-y-1 ">
                <label for="tags" class="block text-[12px] font-medium text-neutral-600">Tags</label>
                <input type="text" id="tags" name="tags" placeholder="hero, dark, saas (comma separated)" class="h-8 w-full rounded-md border border-neutral-300 bg-white px-2.5 text-[13px] text-neutral-900 placeholder-neutral-400 transition-colors focus:border-neutral-900 focus:outline-none focus:ring-1 focus:ring-neutral-900">
            </div>
            <div class="space-y-1">
                <label for="isPublished" class="block text-[12px] font-medium text-neutral-600">Visibility</label>
                <select id="isPublished" name="isPublished" class="h-8 w-full rounded-md border border-neutral-300 bg-white px-2.5 text-[13px] text-neutral-900 placeholder-neutral-400 transition-colors focus:border-neutral-900 focus:outline-none focus:ring-1 focus:ring-neutral-900">
                    <option value="true">Public gallery and my library</option>
                    <option value="false">My library only (private)</option>
                </select>
            </div>
        <p id="detailsError" class="col-span-2 hidden text-[12px] text-red-700"></p>
    </div>
    <div class="flex items-center justify-end border-t border-neutral-100 px-4 py-2.5">
        <button id="submitBtn" type="submit" class="h-8 rounded-lg bg-[#111] px-4 text-[13px] font-semibold text-white transition-colors hover:bg-black disabled:opacity-50">Publish</button>
    </div>
</div>
