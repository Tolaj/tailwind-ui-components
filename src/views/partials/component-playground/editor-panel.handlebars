<div class="flex-1 flex w-1/2 flex-col bg-gray-950 border-r border-white/10">

    {{!-- Editor Tab Bar --}}
    <div class="flex items-center justify-between px-4 py-2 bg-gray-900/50 border-b border-white/10">
        <div class="flex items-center gap-3">
            <div class="flex items-center gap-2 px-3 py-1.5 bg-gray-950 rounded-lg border border-white/10">
                <svg class="w-3.5 h-3.5 text-orange-400" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 18.178l4.62-1.256.623-6.778H9.026L8.822 7.89h8.79l.418-2.22H6.346l1.061 5.478h8.789l-.39 4.172-3.806 1.045-3.806-1.045-.254-2.912H5.7l.512 6.51z"/>
                </svg>
                <span class="text-xs font-medium text-gray-300">index.html</span>
                <div class="w-1.5 h-1.5 bg-blue-400 rounded-full"></div>
            </div>
        </div>
        <div class="flex items-center gap-1">
            <span class="text-[10px] font-mono text-gray-600 bg-gray-800/50 px-2 py-0.5 rounded">HTML</span>
        </div>
    </div>

    {{!-- Code Editor --}}
    <div class="flex-1 relative">
        <textarea id="htmlEditor" name="htmlEditor" required
            class="absolute inset-0 w-full h-full p-5 bg-gray-950 text-emerald-400 focus:outline-none resize-none font-mono text-sm leading-relaxed placeholder-gray-700 selection:bg-emerald-900/50"
            spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off"
            oninput="handleChangeEditor(event)"></textarea>
    </div>

    {{#if user.llmEnabled}}
    {{> component-playground/ai-chatbox}}
    {{/if}}

</div>
