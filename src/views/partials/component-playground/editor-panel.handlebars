<section class="flex w-1/2 min-w-0 flex-col border-r border-neutral-200 bg-neutral-50">

    {{!-- Pane header --}}
    <div class="flex h-11 items-center justify-between border-b border-neutral-200 bg-white px-4">
        <div class="flex items-center gap-2">
            <svg class="h-4 w-4 text-neutral-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75 22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3-4.5 16.5" />
            </svg>
            <span class="font-mono text-[13px] text-neutral-800">index.html</span>
        </div>
        <span id="sourceBadge" class="rounded-full border border-neutral-200 px-2 py-0.5 text-[11px] font-medium text-neutral-500">HTML</span>
    </div>

    {{!-- Code editor --}}
    <div class="relative flex-1 min-h-0">
        <textarea id="htmlEditor" name="htmlEditor" required
            class="absolute inset-0 h-full w-full resize-none border-0 bg-neutral-50 p-5 font-mono text-[13px] leading-6 text-neutral-900 placeholder-neutral-400 focus:bg-white focus:outline-none focus:ring-0 transition-colors"
            spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off"
            oninput="handleChangeEditor(event)"></textarea>
    </div>

    {{#if user.llmEnabled}}
    {{> component-playground/ai-chatbox}}
    {{/if}}

</section>
