{{!-- Component Editor Modal --}}
<el-dialog>
    <dialog id="dialog"
        class="fixed inset-0 size-auto max-h-none max-w-none overflow-y-auto bg-transparent backdrop:bg-transparent">

        <el-dialog-backdrop
            class="fixed inset-0 bg-black/40 transition-opacity data-closed:opacity-0 data-enter:duration-200 data-enter:ease-out data-leave:duration-150 data-leave:ease-in">
        </el-dialog-backdrop>

        <div class="flex min-h-full items-center justify-center p-4 sm:p-8">
            <el-dialog-panel
                class="relative w-full max-w-6xl overflow-hidden rounded-xl border border-neutral-200 bg-white text-left shadow-[0_16px_48px_rgba(0,0,0,0.2)]">

                {{!-- Header --}}
                <header class="flex h-14 items-center justify-between gap-4 border-b border-neutral-200 bg-white px-5">
                    <div class="flex items-center gap-3 min-w-0">
                        <h2 class="text-[15px] font-semibold tracking-tight text-neutral-900 truncate">New component</h2>
                    </div>

                    <ol class="hidden sm:flex items-center gap-2 text-[13px]" aria-label="Progress">
                        <li id="stepIndicator1" class="flex items-center gap-2">
                            <div class="h-2 w-2 rounded-full bg-neutral-900"></div>
                            <span class="font-medium text-neutral-900">Code</span>
                        </li>
                        <li aria-hidden="true" class="h-px w-6 bg-neutral-200"></li>
                        <li id="stepIndicator2" class="flex items-center gap-2">
                            <div class="h-2 w-2 rounded-full bg-neutral-300"></div>
                            <span class="font-medium text-neutral-400">Details</span>
                        </li>
                    </ol>

                    <div class="flex items-center gap-2">
                        <button id="cancelBtn" type="button" onclick="handleClose()"
                            class="h-9 rounded-md border border-neutral-300 bg-white px-3.5 text-[13px] font-medium text-neutral-800 transition-colors hover:border-neutral-400 hover:bg-neutral-50">
                            Cancel
                        </button>
                        <button id="backBtn" type="button" onclick="handleBack()"
                            class="hidden h-9 rounded-md border border-neutral-300 bg-white px-3.5 text-[13px] font-medium text-neutral-800 transition-colors hover:border-neutral-400 hover:bg-neutral-50">
                            Back
                        </button>
                        <button id="nextBtn" type="button" onclick="handleNext()"
                            class="h-9 rounded-md bg-black px-4 text-[13px] font-medium text-white transition-colors hover:bg-neutral-800">
                            Continue
                        </button>
                        <button id="submitBtn" type="submit" form="componentForm"
                            class="hidden h-9 rounded-md bg-black px-4 text-[13px] font-medium text-white transition-colors hover:bg-neutral-800 disabled:opacity-50">
                            Publish
                        </button>
                    </div>
                </header>

                <div class="h-[calc(100vh-10rem)] min-h-[420px] flex flex-col">
                    <form id="componentForm" class="relative flex min-h-0 flex-1" method="POST"
                        action="javascript:void(0);" onsubmit="handleSave(event)">

                        {{> component-playground/editor-panel}}
                        {{> component-playground/preview-panel}}
                        {{> component-playground/details-panel}}

                    </form>
                </div>

            </el-dialog-panel>
        </div>

    </dialog>
</el-dialog>

<script>
    document.getElementById("htmlEditor").placeholder = '<div class="p-8">\n  <h1 class="text-3xl font-bold">Hello world</h1>\n  <p class="mt-2 text-gray-600">Paste or write your component HTML here.</p>\n</div>';
</script>
<script type="module" src="/public/js/playground/playground.js"></script>
