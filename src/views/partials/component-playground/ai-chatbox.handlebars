{{!-- AI Chatbox --}}
<div class="flex flex-col gap-2 border-t border-neutral-200 bg-white p-3">

    <div id="aiMessages" class="flex flex-col gap-2 max-h-32 overflow-y-auto hidden"></div>

    <div id="aiSkeleton" class="hidden flex-col gap-2 px-1">
        <div class="flex items-center gap-2">
            <div class="h-1.5 w-1.5 animate-pulse rounded-full bg-neutral-900"></div>
            <span class="animate-pulse text-xs text-neutral-500">Generating component...</span>
        </div>
        <div class="space-y-1.5">
            <div class="h-2 w-full animate-pulse rounded bg-neutral-100"></div>
            <div class="h-2 w-5/6 animate-pulse rounded bg-neutral-100"></div>
            <div class="h-2 w-4/6 animate-pulse rounded bg-neutral-100"></div>
        </div>
    </div>

    <div class="relative flex items-center">
        <svg class="pointer-events-none absolute left-3 h-4 w-4 text-neutral-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09Z" />
        </svg>
        <input type="text" id="aiPromptInput" placeholder="Describe a component to generate"
            class="h-10 flex-1 rounded-md border border-neutral-300 bg-white pl-9 pr-12 text-[13px] text-neutral-900 placeholder-neutral-400 transition-colors focus:border-neutral-900 focus:outline-none focus:ring-1 focus:ring-neutral-900" />

        <button id="aiGenerateBtn" type="button" onclick="handleAIGenerate()" title="Generate with AI"
            class="absolute right-1.5 flex h-7 w-7 items-center justify-center rounded bg-black text-white transition-colors hover:bg-neutral-800">
            <svg id="aiSendIcon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-4 w-4">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 10.5 12 3m0 0 7.5 7.5M12 3v18" />
            </svg>
            <svg id="aiSpinner" class="hidden h-4 w-4 animate-spin" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
        </button>
    </div>
</div>
