{{!-- AI Chatbox --}}
<div class="border-t border-white/10 bg-gray-900/80 p-3 flex flex-col gap-2">

    {{!-- Messages Area --}}
    <div id="aiMessages" class="flex flex-col gap-2 max-h-32 overflow-y-auto hidden">
    </div>

    {{!-- Skeleton Loader --}}
    <div id="aiSkeleton" class="hidden flex-col gap-2 px-1">
        <div class="flex items-center gap-2 mb-1">
            <div class="w-2 h-2 bg-emerald-400 rounded-full animate-pulse"></div>
            <span class="text-xs text-gray-500 animate-pulse">Generating component...</span>
        </div>
        <div class="space-y-1.5">
            <div class="h-2 bg-white/5 rounded animate-pulse w-full"></div>
            <div class="h-2 bg-white/5 rounded animate-pulse w-5/6"></div>
            <div class="h-2 bg-white/5 rounded animate-pulse w-full"></div>
            <div class="h-2 bg-white/5 rounded animate-pulse w-4/6"></div>
        </div>
    </div>

    {{!-- Input Area --}}
    <div class="flex items-center gap-2 relative">
        <div class="absolute left-3 pointer-events-none">
            <svg class="w-4 h-4 text-gray-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09ZM18.259 8.715 18 9.75l-.259-1.035a3.375 3.375 0 0 0-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 0 0 2.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 0 0 2.455 2.456L21.75 6l-1.036.259a3.375 3.375 0 0 0-2.455 2.456ZM16.894 20.567 16.5 21.75l-.394-1.183a2.25 2.25 0 0 0-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 0 0 1.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 0 0 1.423 1.423l1.183.394-1.183.394a2.25 2.25 0 0 0-1.423 1.423Z" />
            </svg>
        </div>
        <input type="text" id="aiPromptInput" placeholder="Describe a component to generate..."
            class="flex-1 bg-gray-950 border border-white/10 text-sm text-white pl-9 pr-12 py-2.5 rounded-xl
                   focus:outline-none focus:border-emerald-500/50 focus:ring-1 focus:ring-emerald-500/20 placeholder-gray-600 transition-all" />

        <button id="aiGenerateBtn" type="button" onclick="handleAIGenerate()"
            class="absolute right-2 flex items-center justify-center p-1 rounded-lg hover:bg-white/10 transition-colors"
            title="Generate with AI">
            <svg id="aiSendIcon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"
                class="w-5 h-5 text-emerald-400">
                <path d="M3.105 2.288a.75.75 0 0 0-.826.95l1.414 4.926A1.5 1.5 0 0 0 5.135 9.25h6.115a.75.75 0 0 1 0 1.5H5.135a1.5 1.5 0 0 0-1.442 1.086l-1.414 4.926a.75.75 0 0 0 .826.95 28.897 28.897 0 0 0 15.293-7.154.75.75 0 0 0 0-1.115A28.897 28.897 0 0 0 3.105 2.288Z" />
            </svg>
            <svg id="aiSpinner" class="w-5 h-5 text-emerald-400 animate-spin hidden" xmlns="http://www.w3.org/2000/svg"
                fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor"
                    d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z">
                </path>
            </svg>
        </button>
    </div>

</div>
