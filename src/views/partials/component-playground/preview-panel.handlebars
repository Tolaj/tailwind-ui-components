{{!-- Preview Panel --}}
<section class="relative flex w-1/2 min-w-0 flex-col bg-white">

    <div class="flex h-11 items-center justify-between border-b border-neutral-200 bg-white px-4">
        <div class="flex items-center gap-2">
            <span class="text-[13px] font-medium text-neutral-800">Preview</span>
            <span class="h-1.5 w-1.5 rounded-full bg-[#0b7a3e]"></span>
        </div>
        <div class="flex items-center gap-0.5">
            <button id="movementButton" type="button" onclick="handleMovement()" title="Pan tool"
                class="flex h-7 w-7 items-center justify-center rounded-md bg-slate-200 text-neutral-900 transition-colors hover:bg-neutral-200">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-4 w-4"><path stroke-linecap="round" stroke-linejoin="round" d="M10.05 4.575a1.575 1.575 0 1 0-3.15 0v3m3.15-3v-1.5a1.575 1.575 0 0 1 3.15 0v1.5m-3.15 0 .075 5.925m3.075.75V4.575m0 0a1.575 1.575 0 0 1 3.15 0V15M6.9 7.575a1.575 1.575 0 1 0-3.15 0v8.175a6.75 6.75 0 0 0 6.75 6.75h2.018a5.25 5.25 0 0 0 3.712-1.538l1.732-1.732a5.25 5.25 0 0 0 1.538-3.712l.003-2.024a.668.668 0 0 1 .198-.471 1.575 1.575 0 1 0-2.228-2.228 3.818 3.818 0 0 0-1.12 2.687M6.9 7.575V12m6.27 4.318A4.49 4.49 0 0 1 16.35 15m.002 0h-.002" /></svg>
            </button>
            <button type="button" onclick="clearEditor()" title="Reset editor" class="flex h-7 w-7 items-center justify-center rounded-md text-neutral-500 transition-colors hover:bg-neutral-100 hover:text-neutral-900">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-4 w-4"><path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99" /></svg>
            </button>
            <button id="shortScreenTools" type="button" onclick="handleDisplaySize()" title="Toggle device size" class="flex h-7 w-7 items-center justify-center rounded-md text-neutral-500 transition-colors hover:bg-neutral-100 hover:text-neutral-900">
                <div class="size-icon"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-4 w-4"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 1.5H8.25A2.25 2.25 0 0 0 6 3.75v16.5a2.25 2.25 0 0 0 2.25 2.25h7.5A2.25 2.25 0 0 0 18 20.25V3.75a2.25 2.25 0 0 0-2.25-2.25H13.5m-3 0V3h3V1.5m-3 0h3m-3 18.75h3" /></svg></div>
            </button>
            <button type="button" onclick="togglePreviewFullscreen()" title="Toggle fullscreen" class="flex h-7 w-7 items-center justify-center rounded-md text-neutral-500 transition-colors hover:bg-neutral-100 hover:text-neutral-900">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-4 w-4"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3.75v4.5m0-4.5h4.5m-4.5 0L9 9M3.75 20.25v-4.5m0 4.5h4.5m-4.5 0L9 15M20.25 3.75h-4.5m4.5 0v4.5m0-4.5L15 9m5.25 11.25h-4.5m4.5 0v-4.5m0 4.5L15 15" /></svg>
            </button>
        </div>
    </div>

    <style id="previewPointerStyle">
        #preview:hover * { pointer-events: none; }
    </style>
    <style>
        .grid-bg {
            background-color: #fff;
            background-image: radial-gradient(circle, #e5e5e5 1px, transparent 1px);
            background-size: 16px 16px;
        }
    </style>

    <div id="preview-wrapper" class="grid-bg preview-wrapper w-full flex-1 overflow-auto">
        <div id="fullScreenTools" class="fixed left-4 top-4 z-50 flex w-fit flex-row items-center gap-1 rounded-lg border border-neutral-200 bg-white p-1 shadow-[0_6px_20px_rgba(0,0,0,0.12)] hidden">
            <button id="movementButton2" type="button" onclick="handleMovement()"
                class="flex h-8 w-8 items-center justify-center rounded-md bg-slate-200 text-neutral-900 transition-colors hover:bg-neutral-200">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-4 w-4"><path stroke-linecap="round" stroke-linejoin="round" d="M10.05 4.575a1.575 1.575 0 1 0-3.15 0v3m3.15-3v-1.5a1.575 1.575 0 0 1 3.15 0v1.5m-3.15 0 .075 5.925m3.075.75V4.575m0 0a1.575 1.575 0 0 1 3.15 0V15M6.9 7.575a1.575 1.575 0 1 0-3.15 0v8.175a6.75 6.75 0 0 0 6.75 6.75h2.018a5.25 5.25 0 0 0 3.712-1.538l1.732-1.732a5.25 5.25 0 0 0 1.538-3.712l.003-2.024a.668.668 0 0 1 .198-.471 1.575 1.575 0 1 0-2.228-2.228 3.818 3.818 0 0 0-1.12 2.687M6.9 7.575V12m6.27 4.318A4.49 4.49 0 0 1 16.35 15m.002 0h-.002" /></svg>
            </button>
            <button type="button" onclick="handleDisplaySize()" class="flex h-8 w-8 items-center justify-center rounded-md text-neutral-500 hover:bg-neutral-100 hover:text-neutral-900">
                <div class="size-icon"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-4 w-4"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 1.5H8.25A2.25 2.25 0 0 0 6 3.75v16.5a2.25 2.25 0 0 0 2.25 2.25h7.5A2.25 2.25 0 0 0 18 20.25V3.75a2.25 2.25 0 0 0-2.25-2.25H13.5m-3 0V3h3V1.5m-3 0h3m-3 18.75h3" /></svg></div>
            </button>
            <button type="button" onclick="togglePreviewFullscreen()" class="flex h-8 w-8 items-center justify-center rounded-md text-neutral-500 hover:bg-neutral-100 hover:text-neutral-900">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-4 w-4"><path stroke-linecap="round" stroke-linejoin="round" d="M9 9V4.5M9 9H4.5M9 9 3.75 3.75M9 15v4.5M9 15H4.5M9 15l-5.25 5.25M15 9h4.5M15 9V4.5M15 9l5.25-5.25M15 15h4.5M15 15v4.5m0-4.5 5.25 5.25" /></svg>
            </button>
        </div>
        <div id="fsCodePanel" class="fixed left-0 top-0 z-40 hidden h-80 w-[420px] min-h-[160px] min-w-[280px] resize flex-col overflow-hidden rounded-lg border border-neutral-200 bg-white shadow-[0_6px_20px_rgba(0,0,0,0.12)]">
            <div id="fsCodeHeader" class="flex h-9 shrink-0 cursor-move select-none items-center justify-between border-b border-neutral-200 bg-neutral-50 px-3">
                <span class="font-mono text-[12px] text-neutral-700">index.html</span>
                <button id="fsMinBtn" type="button" onclick="toggleFullscreenCode()" title="Minimize" class="flex h-6 w-6 cursor-pointer items-center justify-center rounded text-neutral-500 hover:bg-neutral-200 hover:text-neutral-900">
                    <svg id="fsMinIcon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-3.5 w-3.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14" /></svg>
                    <svg id="fsMaxIcon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="hidden h-3.5 w-3.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 5v14M5 12h14" /></svg>
                </button>
            </div>
            <textarea id="fsCodeEditor" spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off"
                class="min-h-0 w-full flex-1 resize-none border-0 bg-neutral-50 p-3 font-mono text-[12px] leading-5 text-neutral-900 focus:bg-white focus:outline-none focus:ring-0"></textarea>
        </div>
        <div id="preview" class="relative w-screen flex-1 border border-dashed border-neutral-300 bg-white p-1"></div>
    </div>
</section>
